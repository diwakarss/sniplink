{
  "name": "url-shortener",
  "version": "2.0.0",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "npm run dev --workspace=@url-shortener/api",
    "dev:api": "npm run dev --workspace=@url-shortener/api",
    "dev:ui": "npm run dev --workspace=@url-shortener/admin-ui",
    "build": "npm run build --workspaces",
    "build:api": "npm run build --workspace=@url-shortener/api",
    "build:ui": "npm run build --workspace=@url-shortener/admin-ui",
    "test": "npm run test --workspace=@url-shortener/api",
    "test:coverage": "npm run test:coverage --workspace=@url-shortener/api"
  }
}
